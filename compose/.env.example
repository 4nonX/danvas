# danvas instance settings, read by compose.yml / docker-compose.yml.
# Save as .env next to the compose file (or paste into the .env editor of
# Dockge, Arcane, Portainer, ...), then fill in the three secrets below, each
# with `openssl rand -hex 32`. install.sh does all of this for you.
# Never commit .env, and keep a copy: without AI_SECRET, stored AI keys and
# MFA secrets cannot be decrypted.

# Reachability ------------------------------------------------------------------
# The address users open in the browser (no trailing slash).
APP_URL=http://localhost:8005
# true behind HTTPS (reverse proxy), false for plain http on the LAN; a wrong
# value breaks sign-in.
COOKIE_SECURE=false
# Host port and bind address: 127.0.0.1 = only for a reverse proxy on this
# host; 0.0.0.0 = open http://<server>:8005 from other machines on the LAN.
APP_PORT=8005
BIND_ADDR=127.0.0.1
TZ=UTC
# User and group the app runs as; files in data/storage belong to them on the
# host. 1000 is the first user on most Linux systems (`id -u` shows yours).
PUID=1000
PGID=1000

# Version ------------------------------------------------------------------------
# The release to run, e.g. v0.1.6 (empty: the latest release). install.sh and
# update.sh set it; changing it and redeploying switches to that release.
DANVAS_VERSION=
# Image to pull; change only for your own build or a mirror.
# DANVAS_IMAGE=ghcr.io/4nonx/danvas
# Where the database and uploads are kept (default: ./data next to the compose file).
# DATA_DIR=./data

# Secrets (required; install.sh generates them when empty) ----------------------
JWT_SECRET=
AI_SECRET=
POSTGRES_PASSWORD=

# Instance identity --------------------------------------------------------------
# Name shown in the interface instead of "danvas" (empty = danvas).
INSTANCE_NAME=
# Accent color of the interface as #rrggbb (empty = danvas cobalt).
INSTANCE_ACCENT=
# Language for everyone who has not picked one, e.g. de or en-GB
# (empty = the browser's language).
INSTANCE_LOCALE=

# Content ------------------------------------------------------------------------
# off hides the built-in starter templates.
BUILTIN_TEMPLATES=on
# hycanvas seeds HyCanvas's own brand kit into new workspaces (off by default).
BRAND_STARTER_KIT=off
# Upload quota per workspace in bytes (0 = unlimited).
ASSET_QUOTA_BYTES=0

# Sign-in ------------------------------------------------------------------------
# Without email delivery: after creating your accounts, close self sign-up
# (AUTH_PASSWORD_SIGNUP_ENABLED=false); magic links need email, so off.
AUTH_PASSWORD_SIGNUP_ENABLED=true
AUTH_MAGICLINK_LOGIN_ENABLED=false
# Optional single sign-on through an OIDC provider (Authentik, Keycloak,
# Google, ...). Redirect URL at the provider: <APP_URL>/api/v1/auth/oidc/callback
# OIDC_ISSUER=https://sso.example.org/application/o/danvas/
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_LABEL=SSO
# Private CA (e.g. an OIDC provider with an internal certificate): put the
# bundle at deploy/ca-bundle.crt, mount it in compose.yaml and set:
# SSL_CERT_FILE=/app/ca-bundle.crt
