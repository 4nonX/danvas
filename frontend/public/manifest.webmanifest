{
  "id": "/",
  "name": "danvas",
  "short_name": "danvas",
  "description": "Open-source, self-hostable design tool, based on HyCanvas.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "background_color": "#EEF2FD",
  "theme_color": "#2F55D4",
  "icons": [
    { "src": "/icon-192.png?v=d1", "sizes": "192x192", "type": "image/png", "purpose": "any maskable" },
    { "src": "/icon-512.png?v=d1", "sizes": "512x512", "type": "image/png", "purpose": "any maskable" }
  ],
  "shortcuts": [
    {
      "name": "New design",
      "url": "/new/?kind=design",
      "icons": [{ "src": "/icon-192.png?v=d1", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "New presentation",
      "url": "/new/?kind=presentation",
      "icons": [{ "src": "/icon-192.png?v=d1", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "New whiteboard",
      "url": "/new/?kind=whiteboard",
      "icons": [{ "src": "/icon-192.png?v=d1", "sizes": "192x192", "type": "image/png" }]
    }
  ]
}
